{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kazper",
  "version": "0.1.0",
  "identifier": "com.kazperkreative.kazper",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Kazper",
    "longDescription": "Kazper's desktop app: the same brain as on Discord, a hotkey away.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
