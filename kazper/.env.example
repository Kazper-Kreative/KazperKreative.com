# Copy to kazper/.env and fill in (locally). On Railway, set these as service variables.
# Never commit .env — the repo's .gitignore already excludes .env*.

# --- Required ---------------------------------------------------------------

# Discord bot token (Developer Portal > Kazper app > Bot > Reset Token)
DISCORD_TOKEN=
# Your own Discord user ID. Kazper only listens to this account.
OWNER_DISCORD_ID=

# Any OpenAI-compatible endpoint (OpenRouter now; your own vLLM GPU later).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Thinking effort: none, low, medium, xhigh (OpenRouter-specific; blank for vLLM/Ollama).
# Everyday chat uses LLM_REASONING_EFFORT; briefings and weekly reviews use the DEEP one.
LLM_REASONING_EFFORT=low
LLM_DEEP_REASONING_EFFORT=medium
# Optional: preferred OpenRouter providers, comma-separated (e.g. "Tenstorrent,Chutes"); blank = OpenRouter picks.
# Falls back to others if these are down. Check `!stats` cost data before pinning.
LLM_PROVIDER_ORDER=
# How many recent chat turns are replayed each message. Older ones Kazper looks up on demand.
RECENT_TURNS=6

# --- Heartbeat --------------------------------------------------------------

TIMEZONE=America/New_York
# 24h HH:MM in TIMEZONE, or "off"
BRIEFING_TIME=07:00
# Weekly self-review of 👎 / corrections → proposed 📝 notes. Day (mon…sun) or "off", and HH:MM.
REVIEW_DAY=sun
REVIEW_TIME=18:00

# --- Memory (unset = local SQLite in kazper/data/) ---------------------------

# Same Supabase project as the site. SERVICE-ROLE key: server-only, never in the browser.
SUPABASE_URL=https://lenbcecnvjaylhigtlfl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Web app door ------------------------------------------------------------

# Shared secret between this runtime and the website (/kazper). Set the SAME value as
# KAZPER_API_SECRET on Vercel. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Blank = the HTTP API stays off and Kazper is Discord-only.
KAZPER_API_SECRET=

# --- Senses (each one switches on when its values are set) -------------------

# Google Calendar + Gmail, read-only. Fill the client id/secret, then run
#   python -m kazper.setup_google
# which writes GOOGLE_REFRESH_TOKEN for you.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Slack user token (xoxp-...) from your Kazper Slack app (see README).
SLACK_USER_TOKEN=

# Comma-separated words Kazper flags in Discord servers it's in (mentions of you are always flagged).
DISCORD_WATCH_KEYWORDS=kazper
# Server IDs Kazper may be in (Discord: Settings > Advanced > Developer Mode, then right-click a
# server > Copy Server ID), comma-separated. He leaves any other server, including ones he's invited
# to later. Empty = he stays where he is but records nothing from anyone else (DM-only sense).
DISCORD_ALLOWED_GUILDS=

# CryptidKeep MCP. Make a token just for Kazper rather than reusing Claude's.
CRYPTIDKEEP_MCP_URL=https://cryptidkeep-production.up.railway.app/mcp
CRYPTIDKEEP_TOKEN=

# Railway workspace token (railway.com/account/tokens, pick the workspace — not "No workspace").
# Railway can't make read-only tokens; Kazper only ever sends queries with it.
RAILWAY_API_TOKEN=
