# Copy to kazper/.env and fill in (locally). On Railway, set these as service variables.
# Never commit .env — the repo's .gitignore already excludes .env*.

# --- Required ---------------------------------------------------------------

# Discord bot token (Developer Portal > Kazper app > Bot > Reset Token)
DISCORD_TOKEN=
# Your own Discord user ID. Kazper only listens to this account.
OWNER_DISCORD_ID=

# Any OpenAI-compatible endpoint (OpenRouter now; your own vLLM GPU later).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Thinking effort: none, low, medium, xhigh (OpenRouter-specific; blank for vLLM/Ollama).
LLM_REASONING_EFFORT=low
HISTORY_LIMIT=20

# --- Heartbeat --------------------------------------------------------------

TIMEZONE=America/New_York
# 24h HH:MM in TIMEZONE, or "off"
BRIEFING_TIME=07:00

# --- Memory (unset = local SQLite in kazper/data/) ---------------------------

# Same Supabase project as the site. SERVICE-ROLE key: server-only, never in the browser.
SUPABASE_URL=https://lenbcecnvjaylhigtlfl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Senses (each one switches on when its values are set) -------------------

# Google Calendar + Gmail, read-only. Fill the client id/secret, then run
#   python -m kazper.setup_google
# which writes GOOGLE_REFRESH_TOKEN for you.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Slack user token (xoxp-...) from your Kazper Slack app (see README).
SLACK_USER_TOKEN=

# Comma-separated words Kazper flags in Discord servers it's in (mentions of you are always flagged).
DISCORD_WATCH_KEYWORDS=kazper

# CryptidKeep MCP. Make a token just for Kazper rather than reusing Claude's.
CRYPTIDKEEP_MCP_URL=https://cryptidkeep-production.up.railway.app/mcp
CRYPTIDKEEP_TOKEN=

# Railway workspace token (railway.com/account/tokens, pick the workspace — not "No workspace").
# Railway can't make read-only tokens; Kazper only ever sends queries with it.
RAILWAY_API_TOKEN=
